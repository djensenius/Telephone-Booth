{
  "annotations": {
    "list": []
  },
  "description": "Pi CPU and GL.iNet router battery and thermal-zone temperatures.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current Raspberry Pi CPU temperature. Warning at 70 °C; critical at 80 °C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_cpu_temperature_celsius{booth_id=~\"$booth\"}",
          "instant": true,
          "legendFormat": "Pi CPU · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current Pi CPU temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current GL.iNet router battery temperature. Warning at 45 °C; critical at 55 °C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 45 },
              { "color": "red", "value": 55 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "glinet_battery_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\"}",
          "instant": true,
          "legendFormat": "Battery · {{instance}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current router battery temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current hottest exported thermal zone per selected router. Warning at 70 °C; critical at 80 °C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "topk by (instance) (1, glinet_thermal_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\"})",
          "instant": true,
          "legendFormat": "{{name}} ({{zone}}) · {{instance}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current hottest router zone",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Selected Pi CPU, router battery, and hottest router-zone temperatures on one scale.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 45 },
                    { "color": "red", "value": 55 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "booth_cpu_temperature_celsius{booth_id=~\"$booth\"}",
          "legendFormat": "Pi CPU · {{booth_id}}",
          "refId": "A"
        },
        {
          "expr": "glinet_battery_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\"}",
          "legendFormat": "Router battery · {{instance}}",
          "refId": "B"
        },
        {
          "expr": "max by (instance) (glinet_thermal_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\"})",
          "legendFormat": "Hottest router zone · {{instance}}",
          "refId": "C"
        }
      ],
      "title": "Pi and router temperatures",
      "type": "timeseries"
    },
