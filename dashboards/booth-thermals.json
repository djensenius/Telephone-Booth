    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Kernel-requested fan PWM duty. This is a commanded electrical value and does not prove the rotor is moving.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 39 },
      "id": 20,
