{
  "annotations": {
    "list": []
  },
  "description": "Pi, GL.iNet router, fan, and modeled outdoor-weather correlation.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Weather data by Open-Meteo.com",
      "tooltip": "Open-Meteo weather data attribution",
      "type": "link",
      "url": "https://open-meteo.com/"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current Raspberry Pi CPU temperature. Warning at 70 °C; critical at 80 °C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_cpu_temperature_celsius{booth_id=~\"$booth\"}",
          "instant": true,
          "legendFormat": "Pi CPU · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current Pi CPU temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current GL.iNet router battery temperature. Warning at 45 °C; critical at 55 °C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 45 },
              { "color": "red", "value": 55 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "glinet_battery_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\"}",
          "instant": true,
          "legendFormat": "Battery · {{instance}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current router battery temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current hottest modem thermal zone across mdmq6-0 and mdmss-0 through mdmss-2. Warning at 70 °C; critical at 80 °C.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "topk by (instance) (1, glinet_thermal_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\",name=~\"mdmq6-0|mdmss-[0-2]\"})",
          "instant": true,
          "legendFormat": "{{name}} ({{zone}}) · {{instance}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current modem temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current modeled outdoor air temperature from Open-Meteo. This is outdoor context, not an enclosure sensor.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_outdoor_weather_temperature_celsius{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "instant": true,
          "legendFormat": "Outdoor · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current outdoor temperature",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current Open-Meteo WMO weather code mapped to a readable condition.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            {
              "options": {
                "0": { "color": "yellow", "text": "Clear sky" },
                "1": { "color": "yellow", "text": "Mainly clear" },
                "2": { "color": "blue", "text": "Partly cloudy" },
                "3": { "color": "gray", "text": "Overcast" },
                "45": { "color": "gray", "text": "Fog" },
                "48": { "color": "gray", "text": "Rime fog" },
                "51": { "color": "blue", "text": "Light drizzle" },
                "53": { "color": "blue", "text": "Drizzle" },
                "55": { "color": "blue", "text": "Heavy drizzle" },
                "56": { "color": "blue", "text": "Light freezing drizzle" },
                "57": { "color": "blue", "text": "Freezing drizzle" },
                "61": { "color": "blue", "text": "Light rain" },
                "63": { "color": "blue", "text": "Rain" },
                "65": { "color": "blue", "text": "Heavy rain" },
                "66": { "color": "blue", "text": "Light freezing rain" },
                "67": { "color": "blue", "text": "Freezing rain" },
                "71": { "color": "blue", "text": "Light snowfall" },
                "73": { "color": "blue", "text": "Snowfall" },
                "75": { "color": "blue", "text": "Heavy snowfall" },
                "77": { "color": "blue", "text": "Snow grains" },
                "80": { "color": "blue", "text": "Light rain showers" },
                "81": { "color": "blue", "text": "Rain showers" },
                "82": { "color": "blue", "text": "Heavy rain showers" },
                "85": { "color": "blue", "text": "Light snow showers" },
                "86": { "color": "blue", "text": "Snow showers" },
                "95": { "color": "orange", "text": "Thunderstorm" },
                "96": { "color": "red", "text": "Thunderstorm with light hail" },
                "99": { "color": "red", "text": "Thunderstorm with hail" }
              },
              "type": "value"
            },
            {
              "options": { "match": "null", "result": { "color": "gray", "text": "Unavailable" } },
              "type": "special"
            }
          ]
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 6 },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "booth_outdoor_weather_code{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "instant": true,
          "legendFormat": "{{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current condition",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current modeled outdoor relative humidity.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 6 },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_outdoor_weather_relative_humidity_percent{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "instant": true,
          "legendFormat": "Humidity · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Outdoor humidity",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current modeled total cloud cover.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 6 },
      "id": 13,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_outdoor_weather_cloud_cover_percent{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "instant": true,
          "legendFormat": "Cloud cover · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Cloud cover",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Seconds since the booth last fetched a valid Open-Meteo observation. Warning after 20 minutes; critical after one hour.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1200 },
              { "color": "red", "value": 3600 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 6 },
      "id": 14,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "time() - booth_outdoor_weather_last_success_timestamp_seconds{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "instant": true,
          "legendFormat": "Age · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Weather freshness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Whether the latest Open-Meteo request completed and decoded successfully.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "Failed" },
                "1": { "color": "green", "text": "Healthy" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 6 },
      "id": 15,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_outdoor_weather_fetch_success{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "instant": true,
          "legendFormat": "Fetch · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Weather fetch",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current kernel fan PWM command. This is requested duty, not measured rotor speed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 6 },
      "id": 16,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "booth_fan_pwm_ratio{booth_id=~\"$booth\"}",
          "instant": true,
          "legendFormat": "PWM · {{booth_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current fan command",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Pi CPU, router battery, hottest modem zone, and modeled outdoor temperatures on one scale for environmental correlation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 45 },
                    { "color": "red", "value": 55 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 11 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "booth_cpu_temperature_celsius{booth_id=~\"$booth\"}",
          "legendFormat": "Pi CPU · {{booth_id}}",
          "refId": "A"
        },
        {
          "expr": "glinet_battery_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\"}",
          "legendFormat": "Router battery · {{instance}}",
          "refId": "B"
        },
        {
          "expr": "max by (instance) (glinet_thermal_temperature_celsius{job=\"TelephoneRouter\",instance=~\"$router\",name=~\"mdmq6-0|mdmss-[0-2]\"})",
          "legendFormat": "Hottest modem zone · {{instance}}",
          "refId": "C"
        },
        {
          "expr": "booth_outdoor_weather_temperature_celsius{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "legendFormat": "Outdoor · {{booth_id}}",
          "refId": "D"
        },
        {
          "expr": "booth_outdoor_weather_apparent_temperature_celsius{booth_id=~\"$booth\",source=\"open_meteo\"}",
          "legendFormat": "Outdoor feels like · {{booth_id}}",
          "refId": "E"
        }
      ],
      "title": "Pi, router, modem, and outdoor temperatures",
      "type": "timeseries"
    },
